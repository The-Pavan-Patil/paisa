SUPABASE_SERVICE_ROLE_KEY=

# Setu AA (server-only)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# Pricing (server-only)
GOLDAPI_KEY=
MFAPI_BASE_URL=https://api.mfapi.in
